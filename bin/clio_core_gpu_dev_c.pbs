#!/bin/bash
#PBS -N clio_core_gpu_dev_c
#PBS -l select=1:system=polaris
#PBS -l filesystems=home
#PBS -l walltime=02:00:00
#PBS -q capacity
#PBS -A radix-io
#PBS -j oe
#PBS -o /home/hyoklee/log/clio_core_gpu_dev_c.log

set -uo pipefail

# No core dumps: crashing tests left 7.5 GB of 1.2 GB cores in
# $CLIO_BUILD/context-transfer-engine/test/unit (job 7798027) and filled the
# 45 GB /home quota.
ulimit -c 0

export PATH=/home/hyoklee/miniconda3/bin:$PATH
CUDA_LIB=/opt/nvidia/hpc_sdk/Linux_x86_64/25.9/cuda/12.9/targets/x86_64-linux/lib
export LD_LIBRARY_PATH=${CUDA_LIB}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

# Polaris compute nodes have no direct route off-site: every outbound
# connection (git clone, CDash submit) must go through the ALCF proxy.
# These used to be exported only before step [5], so the FetchContent
# git clone in step [3] failed with "Failed to connect to github.com
# port 443" and the configure aborted.
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export no_proxy=localhost,127.0.0.1,.alcf.anl.gov,.anl.gov

CLIO_SRC=/home/hyoklee/clio-core.dev
CLIO_BUILD=/home/hyoklee/clio-core.dev/build_gpu_c
GCC_CC=/usr/bin/gcc-14
GCC_CXX=/usr/bin/g++-14
CUDA_HOST_CXX=/usr/bin/g++-14
# Pin the CUDA compiler to 12.9's nvcc (NOT the 25.9 default, which is 13.0).
# Setting only the lib path is not enough: CMake would auto-detect the 13.0
# nvcc and produce a 13.0-compiler + 12.9-libcudart mismatch at link time.
CUDA_CXX=/opt/nvidia/hpc_sdk/Linux_x86_64/25.9/cuda/12.9/bin/nvcc

# Locally installed header-only nlohmann_json (v3.11.3). With this,
# find_package() succeeds and CMakeLists.txt never reaches its
# FetchContent_Declare(nlohmann_json) fallback, so the configure does not
# depend on the proxy being reachable. Rebuild it on a *login* node with:
#   git clone --depth 1 -b v3.11.3 https://github.com/nlohmann/json.git \
#       ~/deps/src/json
#   cmake -S ~/deps/src/json -B /tmp/nlj -DJSON_BuildTests=OFF \
#       -DCMAKE_INSTALL_PREFIX=~/deps/nlohmann_json && cmake --install /tmp/nlj
NLOHMANN_JSON_ROOT=/home/hyoklee/deps/nlohmann_json

# ─────────────────────────────────────────────────────────────────────────────
# [2] Clean build directory
# ─────────────────────────────────────────────────────────────────────────────
echo "=== [2] Prepare build directory ==="
rm -rf $CLIO_BUILD
mkdir -p $CLIO_BUILD
echo "  Build dir: $CLIO_BUILD (clean)"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# [3] CMake configure
# ─────────────────────────────────────────────────────────────────────────────
echo "=== [3] CMake configure ==="
cd $CLIO_BUILD

export CUDAHOSTCXX=$CUDA_HOST_CXX
export CUDACXX=$CUDA_CXX

cmake $CLIO_SRC \
    -DCMAKE_BUILD_TYPE=Debug \
    -DCMAKE_C_COMPILER=$GCC_CC \
    -DCMAKE_CXX_COMPILER=$GCC_CXX \
    -DCMAKE_CUDA_HOST_COMPILER=$CUDA_HOST_CXX \
    -DCMAKE_CUDA_COMPILER=$CUDA_CXX \
    -DCLIO_CORE_ENABLE_RUNTIME=ON \
    -DCLIO_CORE_ENABLE_CTE=ON \
    -DCLIO_CORE_ENABLE_CAE=ON \
    -DCLIO_CORE_ENABLE_CEE=ON \
    -DCLIO_CORE_ENABLE_TESTS=ON \
    -DCLIO_CORE_ENABLE_BENCHMARKS=ON \
    -DCLIO_CORE_ENABLE_ELF=OFF \
    -DCLIO_CORE_ENABLE_CUDA=ON \
    -DCLIO_CORE_ENABLE_GPU_RUNTIME=ON \
    -DCLIO_CORE_ENABLE_BAM=ON \
    -DCMAKE_CUDA_ARCHITECTURES=80 \
    -DCMAKE_CUDA_STANDARD=17 \
    -DCLIO_CORE_ENABLE_IO_URING=ON \
    -DCLIO_CORE_ENABLE_DOCKER_CI=OFF \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -Dnlohmann_json_ROOT=$NLOHMANN_JSON_ROOT \
    -DSITE=polaris \
    -DBUILDNAME="dev/d/cnd/gpu/bam" \
    2>&1
CMAKE_RC=$?
if [ $CMAKE_RC -ne 0 ]; then
    echo "ERROR: cmake configure failed (exit $CMAKE_RC)"
    exit $CMAKE_RC
fi
echo "  CMake configure: OK"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# [4] Build
# ─────────────────────────────────────────────────────────────────────────────
echo "=== [4] Build (j4) ==="
T_BUILD_START=$(date +%s)
make -j4 2>&1 || make -j1 VERBOSE=1 2>&1
BUILD_RC=$?
T_BUILD_END=$(date +%s)
echo "  Build elapsed: $(( T_BUILD_END - T_BUILD_START )) s"
if [ $BUILD_RC -ne 0 ]; then
    echo "ERROR: build failed (exit $BUILD_RC)"
    exit $BUILD_RC
fi
echo "  Build: OK"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# [5] ctest -D Experimental (build + test + submit to CDash)
# ─────────────────────────────────────────────────────────────────────────────
echo "=== [5] ctest -D Continuous ==="

# (proxy already exported at the top of the script)
# ctest -D Experimental -j4 2>&1
ctest -D Continuous -j4 2>&1
CTEST_RC=$?

echo ""
echo "  ctest exit: $CTEST_RC"
echo "  Results: https://my.cdash.org/index.php?project=HERMES"
echo "==== Done ===="
echo "Date: $(date)"
