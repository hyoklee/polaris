#!/bin/bash
#PBS -N vfd_gds_test
#PBS -l select=1:ncpus=32:ngpus=4
#PBS -l walltime=00:30:00
#PBS -q debug
#PBS -A gpu_hack
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /home/hyoklee/vfd_gds_test.log

set -uo pipefail

VFD_BUILD=/lus/grand/projects/gpu_hack/hyoklee/vfd-gds/build
CMAKE_BIN=/home/hyoklee/miniconda3/bin

export PATH=${CMAKE_BIN}:$PATH

# ─────────────────────────────────────────────────────────────────────────────
# Runtime library paths — RAPIDS 24.10 cuFile (1.10.1) before CUDA 11.8 (1.4)
# ─────────────────────────────────────────────────────────────────────────────
export LD_LIBRARY_PATH=\
${VFD_BUILD}/bin:\
/home/hyoklee/hdf5-install/lib:\
/soft/applications/dask_rapids/rapids-24.10_polaris/lib:\
/opt/cray/pe/mpich/9.0.1/ofi/nvidia/23.3/lib:\
/opt/nvidia/hpc_sdk/Linux_x86_64/25.5/cuda/12.9/targets/x86_64-linux/lib:\
/opt/cray/pe/lib64:\
/opt/cray/libfabric/2.2.0rc1/lib64:\
/opt/cray/pals/1.7/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

export HDF5_PLUGIN_PATH=${VFD_BUILD}/bin
export CUFILE_ENV_PATH_JSON=/home/hyoklee/cufile.json
# BEST_EFFORT: ignore advisory lock failures (ENOSYS/EAGAIN) so PHDF5 works
# on Lustre where flock(LOCK_EX|LOCK_NB) fails for concurrent MPI opens.
export HDF5_USE_FILE_LOCKING=BEST_EFFORT

# HTTP proxy — required for outbound HTTPS from Polaris compute nodes
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY=http://proxy.alcf.anl.gov:3128
export HTTPS_PROXY=http://proxy.alcf.anl.gov:3128

echo "==== HDF5 VFD-GDS Test ===="
echo "Date:  $(date)"
echo "Job:   ${PBS_JOBID:-interactive}"
echo "Node:  $(cat $PBS_NODEFILE | sort -u | tr '\n' ' ')"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# [1] Environment check
# ─────────────────────────────────────────────────────────────────────────────
echo "=== [1] Environment ==="
nvidia-smi --query-gpu=index,name,driver_version --format=csv,noheader 2>&1 | sed 's/^/  GPU /'
echo "  CUFILE_ENV_PATH_JSON: $CUFILE_ENV_PATH_JSON"
echo "  https_proxy: $https_proxy"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# [2] Single-rank sanity test
# ─────────────────────────────────────────────────────────────────────────────
echo "=== [2] mpiexec -n 1 gds_test (single rank, GPU 0) ==="
cd $VFD_BUILD/bin
CUDA_VISIBLE_DEVICES=0 mpiexec -n 1 ./gds_test 2>&1
SINGLE_RC=$?
echo "  exit: $SINGLE_RC"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# [3] Multi-rank test (2 ranks, each pinned to its own GPU)
# ─────────────────────────────────────────────────────────────────────────────
echo "=== [3] mpiexec -n 2 gds_test (2 ranks, GPU-pinned) ==="
cd $VFD_BUILD/bin
mpiexec -n 2 \
  --cpu-bind depth -d 16 \
  bash -c 'export CUDA_VISIBLE_DEVICES=$PMI_LOCAL_RANK HDF5_USE_FILE_LOCKING=BEST_EFFORT; exec ./gds_test' 2>&1
MPI2_RC=$?
echo "  exit: $MPI2_RC"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# [4] ctest -D Experimental — builds, tests, and submits to CDash
#     SITE=polaris and BUILDNAME=vfd-gds/r/gpu are set in the cmake cache.
# ─────────────────────────────────────────────────────────────────────────────
echo "=== [4] ctest -D Experimental (CDash submission) ==="
cd $VFD_BUILD
ctest -D Experimental 2>&1
CTEST_RC=$?
echo "  ctest exit: $CTEST_RC"
echo "  CDash: https://my.cdash.org/index.php?project=HDF5"
echo ""

echo "==== Done ===="
echo "Date: $(date)"

[ $SINGLE_RC -eq 0 ] && [ $MPI2_RC -eq 0 ]
